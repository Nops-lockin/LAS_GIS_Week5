* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
}

/* Pindahkan tombol zoom Leaflet ke pojok kanan bawah */
.leaflet-top.leaflet-left .leaflet-control-zoom {
  position: fixed;
  bottom: 24px;
  right: 20px;
  margin: 0;
  z-index: 1000;
}

/* SIDEBAR KIRI */
/* Transisi halus saat sidebar bergeser */
#sidebar {
  transition: transform 0.3s ease, margin-left 0.3s ease;
}

/* Keadaan ketika sidebar disembunyikan */
#sidebar.hidden {
  transform: translateX(-100%);
  margin-right: -380px; /* Menarik ruang kosong agar peta melebar penuh */
}

/* Tombol Toggle Floating */
#toggle-sidebar {
  position: absolute;
  top: 15px;
  left: 395px; /* Berada di sebelah kanan sidebar saat terbuka */
  z-index: 1100;
  width: 36px;
  height: 36px;
  background-color: #121829;
  color: #ffffff;
  border: 1px solid #2e3a59;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  transition: left 0.3s ease, background-color 0.2s ease;
}

#toggle-sidebar:hover {
  background-color: #1e2942;
}

/* Posisi tombol saat sidebar tertutup */
#toggle-sidebar.collapsed {
  left: 15px; /* Berpindah ke pojok kiri layar */
}

#sidebar {
  width: 380px;
  height: 100%;
  background-color: #121829;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  z-index: 1000;
  box-shadow: 4px 0 15px rgba(0, 0, 0, 0.3);
  flex-shrink: 0;
}

.sidebar-header {
  padding: 24px 20px 16px 20px;
}

.sidebar-header h2 {
  font-size: 19px;
  font-weight: 700;
  margin-bottom: 4px;
  letter-spacing: -0.3px;
}

.sidebar-header p {
  font-size: 12px;
  color: #8b99af;
  line-height: 1.4;
}

/* STATISTIK UTAMA */
.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 0 20px 16px 20px;
  border-bottom: 1px solid #202940;
}

.stat-item h3 {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
}

.stat-item span {
  font-size: 11px;
  color: #8b99af;
  display: block;
}

/* KARTU HIGHLIGHT PEMBOROSAN */
.waste-card {
  margin: 16px 20px;
  padding: 16px;
  background: linear-gradient(135deg, #2a1b24 0%, #1e1f33 100%);
  border-left: 4px solid #ef4444;
  border-radius: 6px;
}

.waste-card h3 {
  font-size: 24px;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 4px;
}

.waste-card p {
  font-size: 11px;
  color: #a8b3c7;
  line-height: 1.4;
}

/* FORM KONTROL FILTER */
.filter-section {
  padding: 0 20px 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-section label {
  font-size: 12px;
  color: #94a3b8;
}

.filter-select {
  background: #1c2438;
  color: #ffffff;
  border: 1px solid #2e3a59;
  padding: 6px 10px;
  border-radius: 4px;
  font-size: 12px;
  outline: none;
  cursor: pointer;
}

/* DAFTAR CARD TRIP */
.trip-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 20px;
}

.trip-card {
  background-color: #172033;
  border-radius: 6px;
  padding: 12px 14px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
  border-left: 4px solid #3b82f6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.trip-card:hover, .trip-card.active {
  background-color: #202c47;
  transform: translateX(2px);
}

.trip-card.alert {
  border-left-color: #ef4444;
}

.trip-info h4 {
  font-size: 13px;
  font-weight: 600;
  color: #f1f5f9;
  margin-bottom: 3px;
}

.trip-info span {
  font-size: 11px;
  color: #8b99af;
  display: block;
}

.trip-price {
  text-align: right;
}

.trip-price .total-rp {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
}

.trip-price .boros-rp {
  font-size: 10px;
  color: #ef4444;
  display: block;
}

/* LEGENDA SIDEBAR */
.sidebar-legend {
  padding: 14px 20px;
  background-color: #0d1220;
  font-size: 11px;
  border-top: 1px solid #1e263d;
  color: #7e8c9f;
}

.sidebar-legend h5 {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.legend-row {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
}

.legend-bar {
  width: 14px;
  height: 4px;
  margin-right: 8px;
  border-radius: 2px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 8px;
}

/* MAP & POPUP STRUK */
#map {
  flex: 1;
  height: 100%;
}

.leaflet-popup-content-wrapper {
  border-radius: 8px;
  padding: 4px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

.receipt-popup {
  font-size: 12px;
  line-height: 1.5;
  color: #1e293b;
  min-width: 245px;
}

.receipt-header {
  border-bottom: 1px solid #e2e8f0;
  padding-bottom: 6px;
  margin-bottom: 6px;
}

.receipt-header b {
  font-size: 13px;
  color: #0f172a;
}

.receipt-detail {
  margin-bottom: 6px;
}

.receipt-alert {
  color: #b91c1c;
  background: #fef2f2;
  padding: 6px;
  border-radius: 4px;
  margin: 6px 0;
  font-size: 11px;
}

.receipt-saving {
  color: #15803d;
  font-weight: 600;
  font-size: 11px;
}

/* STYLING STRUK / BON TELEMATIKA */
.receipt-popup {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #1e293b;
  padding: 4px;
}

.receipt-header {
  border-bottom: 1px dashed #cbd5e1;
  padding-bottom: 8px;
  margin-bottom: 8px;
}

.receipt-title-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2px;
}

.receipt-title-box b {
  font-size: 14px;
  color: #0f172a;
}

.badge-code {
  background: #0f172a;
  color: #38bdf8;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: bold;
}

.receipt-metrics {
  display: flex;
  justify-content: space-between;
  background-color: #f8fafc;
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 11px;
  margin-bottom: 8px;
}

.receipt-metrics span {
  color: #64748b;
}

.receipt-divider {
  border-top: 1px dashed #cbd5e1;
  margin: 6px 0;
}

.receipt-detail {
  font-size: 12px;
  line-height: 1.6;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 3px;
}

.receipt-row span {
  color: #475569;
}

.receipt-row.highlight-row {
  border-top: 1px dotted #cbd5e1;
  padding-top: 4px;
  margin-top: 4px;
  color: #0f172a;
  font-size: 12.5px;
}

.receipt-row.highlight-row-cost {
  color: #0f172a;
  font-size: 13px;
}

.receipt-row.highlight-row-cost b {
  color: #1d4ed8;
}

.receipt-alert {
  background: #fef2f2;
  border-left: 3px solid #ef4444;
  padding: 8px;
  border-radius: 4px;
  margin: 8px 0;
  font-size: 11px;
  color: #991b1b;
  line-height: 1.5;
}

.receipt-saving {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 11px;
  color: #166534;
  display: flex;
  flex-direction: column;
  gap: 2px;
}